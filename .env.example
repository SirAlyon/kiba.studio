# Form di contatto — configurazione SMTP (server-side).
# Su Vercel: Project Settings → Environment Variables.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tuo-indirizzo@gmail.com
# Per Gmail: usa una App Password (account con 2FA), NON la password normale.
SMTP_PASS=la-tua-app-password

# Destinatario dei messaggi del form (per ora la tua Gmail).
CONTACT_TO=alessiosada04@gmail.com
# Mittente: deve coincidere con l'account autenticato (o un suo alias).
CONTACT_FROM=tuo-indirizzo@gmail.com

# Opzionale: override dell'URL pubblico del sito.
# NUXT_PUBLIC_SITE_URL=https://kiba.studio
